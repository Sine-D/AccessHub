# Web (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_SEARCH_API_URL=http://localhost:8787

# Expo / Expo Go. Use the same Supabase URL and anon key as above.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android emulator: http://10.0.2.2:8787
# Physical phone: replace 192.168.1.100 with the Mac's Wi-Fi IP.
EXPO_PUBLIC_SEARCH_API_URL=http://192.168.1.100:8787
EXPO_PUBLIC_ACCESSIBLE_PLACES_API_URL=http://192.168.1.100:8787

# Never put OPENAI_API_KEY or COMMUNITY_HUB_API_KEY in this file.
