{
  "expo": {
    "name": "AccessHub",
    "slug": "accesshub",
    "scheme": "accesshub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.accesshub.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow AccessHub to convert your speech into an editable search transcript.",
        "NSMicrophoneUsageDescription": "Allow AccessHub to use the microphone for accessible voice search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.accesshub.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AccessHub to use your location to show nearby accessible places."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AccessHub to use the microphone for accessible voice search.",
          "speechRecognitionPermission": "Allow AccessHub to convert your speech into an editable search transcript.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f0e3a724-c496-49a9-bb67-785c4afabea6"
      }
    }
  }
}